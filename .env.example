# 复制为仓库根目录或 services/api/.env

# --- 应用 ---
APP_NAME=智讯通 API
DEBUG=true
DEMO_MODE=true
SCHEDULER_ENABLED=false
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 数据库 ---
# 本地零依赖（默认）：
DATABASE_URL=sqlite:///./zhixuntong.db
# Docker MySQL：
# DATABASE_URL=mysql+pymysql://zxt:zxt123@127.0.0.1:3306/zhixuntong?charset=utf8mb4

# --- 外部系统：mock 可独立演示；组员就绪后改为 http/local ---
CRAWLER_MODE=mock
RAG_MODE=mock
DIFY_MODE=mock
NOTIFY_MODE=log

CRAWLER_BASE_URL=http://127.0.0.1:8001
RAG_BASE_URL=http://127.0.0.1:9380
DIFY_BASE_URL=http://127.0.0.1:80
DIFY_API_KEY=
DINGTALK_WEBHOOK=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=zhixuntong@example.com
